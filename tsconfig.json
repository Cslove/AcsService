{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@/core/*": ["core/*"],
      "@/infrastructure/*": ["infrastructure/*"],
      "@/application/*": ["application/*"],
      "@/api/*": ["api/*"],
      "@/shared/*": ["shared/*"]
    }
  },
  "exclude": ["node_modules"]
}
